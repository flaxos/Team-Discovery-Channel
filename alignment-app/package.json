{
  "name": "alignment-app",
  "version": "1.0.0",
  "description": "Team Discovery Channel Alignment & Game Dev Bootstrapper",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently -n \"API,WEB\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "vite --port 5173 --host",
    "tunnel": "cloudflared tunnel --url http://localhost:4100",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "keywords": [
    "game-dev",
    "agentic-ai",
    "multiplayer",
    "voting",
    "gdd"
  ],
  "author": "flaxos & Scotty",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.6"
  }
}
