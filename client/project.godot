; Engine configuration file.
; Project SGC: Stargate SG-1 / SG-3 Tactical Extraction Shooter
; Team Discovery Channel (flaxos & Scotty)

config_version=5

[application]

config/name="Stargate: SG Extraction"
config/description="Co-op tactical top-down extraction shooter set in the Stargate universe."
run/main_scene="res://scenes/main/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[autoload]

KeybindingManager="*res://scripts/input/KeybindingManager.gd"

NetworkManager="*res://scripts/net/NetworkManager.gd"

[debug]

gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

