[resource]
script = ExtResource("1_preset")
id = &"mothership_bridge"
label = "Mothership bridge"
compatible_modules = PackedStringArray("room11")
attachments = Array[ExtResource("2_attachment")]([SubResource("a_bridge_console"), SubResource("a_side_station_left"), SubResource("a_side_station_right"), SubResource("a_viewport"), SubResource("a_patrol_entry"), SubResource("a_patrol_helm")])
system_references = PackedStringArray("systems.control", "structure.viewport")
description = "Ha'tak command bridge with navigation helm console, tactical side stations, and deep-space observation viewport."
synonyms = PackedStringArray("bridge", "command bridge", "helm")
