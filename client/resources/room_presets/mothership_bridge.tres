approach = Vector3(0, 0, -1.2)
placeholder_size = Vector3(2, 1.1, 1)
scene = ExtResource("3_console")
bounds = AABB(-1, 0, -0.5, 2, 1.1, 1)
references = PackedStringArray("systems.control", "objective.interact")

