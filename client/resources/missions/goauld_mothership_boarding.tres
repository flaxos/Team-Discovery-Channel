[gd_resource type="Resource" script_class="MissionDefinition" load_steps=17 format=3]

[ext_resource type="Script" path="res://scripts/mission/MissionDefinition.gd" id="1_definition"]
[ext_resource type="Script" path="res://scripts/mission/MissionObjective.gd" id="2_objective"]
[ext_resource type="Script" path="res://scripts/mission/MissionPatrol.gd" id="3_patrol"]
[ext_resource type="Resource" path="res://resources/levels/ai2_goauld_mothership_boarding.tres" id="4_layout"]
[ext_resource type="Script" path="res://scripts/mission/MissionObjectiveVariant.gd" id="5_variant"]
[ext_resource type="Script" path="res://scripts/mission/MissionTrigger.gd" id="6_trigger"]

[sub_resource type="Resource" id="reach_cargo"]
script = ExtResource("2_objective")
id = &"reach_cargo"
kind = "reach"
room = &"cargo_bay"
text = "INFILTRATE HA'TAK LOWER CARGO BAY"

[sub_resource type="Resource" id="reach_rings"]
script = ExtResource("2_objective")
id = &"reach_rings"
kind = "reach"
room = &"ring_lower"
text = "REACH LOWER TRANSPORT RING PLATFORM"

[sub_resource type="Resource" id="reach_checkpoint"]
script = ExtResource("2_objective")
id = &"reach_checkpoint"
kind = "reach"
room = &"interior_checkpoint"
text = "SECURE UPPER DECK INTERIOR CHECKPOINT"

[sub_resource type="Resource" id="download_manifest"]
script = ExtResource("2_objective")
id = &"download_manifest"
kind = "interact"
room = &"interior_checkpoint"
attachment = &"console"
text = "ACCESS SHIPBOARD LOGISTICS CONSOLE"
prompt = "DOWNLOAD SHIP MANIFEST"

[sub_resource type="Resource" id="extract_gate"]
script = ExtResource("2_objective")
id = &"extract"
kind = "extract"
room = &"gate"
marker = &"entry"
radius = 4.0
text = "RETURN TO STARGATE FOR EXTRACTION"

[sub_resource type="Resource" id="patrol_cargo"]
script = ExtResource("3_patrol")
rooms = PackedStringArray("vestibule", "cargo_bay")
size = 1

[sub_resource type="Resource" id="patrol_upper"]
script = ExtResource("3_patrol")
rooms = PackedStringArray("upper_hall", "interior_checkpoint")
size = 1

[sub_resource type="Resource" id="obj_recon_ramp"]
script = ExtResource("2_objective")
id = &"recon_ramp"
kind = "reach"
room = &"ramp"
text = "INSPECT THE UPPER DECK ACCESS RAMP FOR AMBUSHES"

[sub_resource type="Resource" id="obj_secure_upper_rings"]
script = ExtResource("2_objective")
id = &"secure_upper_rings"
kind = "reach"
room = &"ring_upper"
text = "SECURE THE UPPER TRANSPORT RING CHAMBER"

[sub_resource type="Resource" id="variant_standard"]
script = ExtResource("5_variant")
id = &"standard"
label = "STANDARD BREACH"
briefing_note = "Direct boarding route from the lower cargo bay to the upper checkpoint."

[sub_resource type="Resource" id="variant_ramp_flank_recon"]
script = ExtResource("5_variant")
id = &"ramp_flank_recon"
label = "DECK RAMP RECON"
briefing_note = "Check the lower-to-upper access ramp before activating the transport rings."
insert_before_id = &"reach_rings"
bonus_objectives = Array[ExtResource("2_objective")]([SubResource("obj_recon_ramp")])

[sub_resource type="Resource" id="variant_upper_ring_sweep"]
script = ExtResource("5_variant")
id = &"upper_ring_sweep"
label = "UPPER RING SECURING"
briefing_note = "Sweep the Deck 1 transport ring platform prior to downloading the manifest."
insert_before_id = &"download_manifest"
bonus_objectives = Array[ExtResource("2_objective")]([SubResource("obj_secure_upper_rings")])

[sub_resource type="Resource" id="trigger_ring_notice"]
script = ExtResource("6_trigger")
id = &"ring_chamber_entry_notice"
condition = "room_entered"
room = &"ring_lower"
action = "show_notice"
notice = "RING CHAMBER REACHED — STEP ONTO PLATFORM TO BREACH DECK 1"

[resource]
script = ExtResource("1_definition")
title = "GOA'ULD MOTHERSHIP — BOARDING & RING BREACH"
layout = ExtResource("4_layout")
objectives = Array[ExtResource("2_objective")]([SubResource("reach_cargo"), SubResource("reach_rings"), SubResource("reach_checkpoint"), SubResource("download_manifest"), SubResource("extract_gate")])
patrols = Array[ExtResource("3_patrol")]([SubResource("patrol_cargo"), SubResource("patrol_upper")])
triggers = Array[ExtResource("6_trigger")]([SubResource("trigger_ring_notice")])
airman_support = false
objective_variants = Array[ExtResource("5_variant")]([SubResource("variant_standard"), SubResource("variant_ramp_flank_recon"), SubResource("variant_upper_ring_sweep")])
