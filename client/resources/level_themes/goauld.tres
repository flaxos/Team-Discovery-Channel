[resource]
script = ExtResource("1")
id = &"goauld"
display_name = "Goa’uld"
description = "Fortified base or ship: dark stone carried on heavy bronze ribs, with gold kept to a band above door-head height."
synonyms = PackedStringArray("goauld", "jaffa", "pyramid", "mothership")
fallback_id = &"neutral"
compatible_families = PackedStringArray("corridor", "chamber", "adapter", "vertical")
lighting = ExtResource("2")
materials = {"ceiling": ExtResource("ceiling"), "detail": ExtResource("bronze"), "door_frame": ExtResource("bronze"), "floor": ExtResource("floor_runner"), "portal": ExtResource("portal"), "prop": ExtResource("prop"), "wall": ExtResource("basalt")}
variants = Array[ExtResource("3")]([SubResource("v0"), SubResource("v1"), SubResource("v2"), SubResource("v3"), SubResource("v4"), SubResource("v5"), SubResource("v6"), SubResource("v7"), SubResource("v8"), SubResource("v9"), SubResource("v10"), SubResource("v11"), SubResource("v12"), SubResource("v13"), SubResource("v14"), SubResource("v15"), SubResource("v16"), SubResource("v17"), SubResource("v18"), SubResource("v19")])
decoration_slots = PackedStringArray("ceiling", "detail", "door_frame", "floor", "portal", "prop", "wall")
art_status = "authored"
