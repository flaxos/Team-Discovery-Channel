palette = PackedColorArray(0.24, 0.16, 0.11, 1)
roughness = 0.85
metallic = 0.0
texture_scale_m = 2.0
wear = "Scuffed edges, restrained grime around joints; legible signage."
reference = "https://rdanderson.com/stargate/cheyenne/index.htm"
replacement_status = "placeholder"
material_slots = PackedStringArray("base_color", "normal", "roughness")

